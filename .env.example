# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require

# LLM provider config: any OpenAI-compatible chat-completions API with tool
# calling works, by changing these three values only. Currently set to
# Gemini's OpenAI-compatible endpoint (free tier has a much larger
# tokens/minute budget than Groq's, and responds in a few seconds).
# Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=replace-me
LLM_MODEL=gemini-3.1-flash-lite

# Groq (an open-weight model, hosted) -- comment Gemini above, uncomment:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=openai/gpt-oss-120b

# Local Ollama install -- no API key, and only works when running the app
# locally (`npm run dev`); the deployed site runs on Netlify's servers and
# can't reach your machine. Comment Gemini above, uncomment:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=<a model you've pulled that supports tools -- qwen2.5:7b-instruct
#            tested reliably, llama3.2:1b did not (see README)>
# If prompt processing is slow on your hardware, QUESTION_BANK_EXAMPLES=0
# below trims the interview prompt a lot for faster local iteration.

# How many example questions per category to embed in the interview
# prompt (default 4). 0 drops the question bank from the prompt entirely --
# much faster on a small/local/CPU-only model, at some cost to how well the
# interviewer improvises within a category.
QUESTION_BANK_EXAMPLES=4

# Shared secret for the /admin.html testing page (list-all-records, delete).
# Generate one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_KEY=replace-me

# Stored for later use -- not currently wired up as an LLM_* provider above.
# Anthropic's native API (api.anthropic.com/v1/messages) isn't OpenAI-
# compatible the way src/llm.js expects, so using this would need either
# their separate OpenAI-compatible endpoint or provider-specific code, not
# just swapping it into LLM_API_KEY.
ANTHROPIC_API_KEY=replace-me
